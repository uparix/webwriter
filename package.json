{
  "name": "webwriter",
  "version": "1.0.0",
  "description": "A writing application for one long book, in the browser.",
  "type": "module",
  "bin": {
    "webwriter": "bin/webwriter.js"
  },
  "scripts": {
    "start": "node bin/webwriter.js",
    "check": "node bin/webwriter.js check",
    "test": "node --import ./test/browser-paths.mjs --test test/",
    "fetch-drawio": "node scripts/fetch-drawio.mjs",
    "postinstall": "node scripts/fetch-drawio.mjs --optional"
  },
  "engines": {
    "node": ">=22.15"
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "codemirror": "^5.65.18",
    "mermaid": "^11.17.2"
  }
}
